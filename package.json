{
  "name": "daymark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run tests/core.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-daymark 'vitest run tests/firestore.test.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.32.0",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
